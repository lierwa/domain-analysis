node_modules/
dist/
.env
.env.local
.DS_Store
*.log
/data/*
!/data/.gitkeep
# npm workspace 会把应用进程 cwd 切到 apps/<name>；任何误落在这里的运行数据都不能进入 Git。
/apps/*/data/
coverage/
.vite/
storage/

# 本机会话、Python 缓存和含原始资料的阶段二验收产物不进入远程仓库。
:memory:.ses
**/__pycache__/
/.scratch/knowledge-processing/*.zip
/.scratch/knowledge-processing/qa/
/.scratch/knowledge-processing/skill-v*-verified/
