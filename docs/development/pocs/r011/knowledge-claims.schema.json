{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://domain-analysis.local/schemas/knowledge-claims.schema.json",
  "title": "Knowledge claim quality fixture",
  "description": "用于 R-011 隔离验证的通用品类知识结论批次，不是生产知识包 Schema。",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_version", "claims"],
  "properties": {
    "package_version": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/knowledgeClaim"
      }
    }
  },
  "definitions": {
    "knowledgeClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "model_id",
        "knowledge_layer",
        "claim_status",
        "evidence_refs",
        "captured_at",
        "conflict_visible"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "knowledge_layer": {
          "type": "string",
          "enum": [
            "specification",
            "function",
            "mechanism",
            "applicability",
            "tradeoff",
            "need_mapping",
            "comparison"
          ]
        },
        "claim_status": {
          "type": "string",
          "enum": [
            "source_fact",
            "deterministic_transform",
            "model_candidate",
            "human_confirmed",
            "conflict",
            "unknown"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "captured_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "conflict_visible": {
          "type": "boolean"
        }
      }
    }
  }
}
