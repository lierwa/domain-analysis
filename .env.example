# 两台开发机共享本地连接配置，但 PostgreSQL 数据分别保留在各自电脑，不通过 Git 同步。
# DBOS 要求连接串显式包含用户名；本地开发账号直接保存在这里，外部环境变量仍可覆盖。
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
JD_CDP_ENDPOINT=http://127.0.0.1:9223
WEB_PORT=6173
DATABASE_URL=file:../../data/domain-analysis.sqlite
POSTGRES_DATABASE_URL=postgresql://guojunxi@127.0.0.1:5432/domain_analysis
EVIDENCE_ROOT=data/evidence
KNOWLEDGE_PACKAGE_ROOT=data/knowledge-packages
INTERVIEW_MODEL_ID=gpt-5.6-terra
INTERVIEW_REASONING_EFFORT=medium
KNOWLEDGE_FACTORY_MODEL_ID=gpt-5.3-codex-spark
KNOWLEDGE_FACTORY_REASONING_EFFORT=low
COLLECTION_ALLOWED_ORIGINS=https://www.haier.com,https://www.leader.com.cn,https://www.midea.cn,https://www.tcl.com,https://www.hisense.com,https://mlmall.meiling.com,https://www.konka.com,https://www.siemens-home.bsh-group.cn,https://www.rsdgroup.com.cn,https://www.jd.com,https://item.jd.com,https://www.energylabel.com.cn,https://www.cnis.ac.cn,https://www.nist.gov,https://www.fsis.usda.gov
CRAWL_CONCURRENCY=1
ANALYSIS_CONCURRENCY=1
REDDIT_COLLECTION_MODE=public_json
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=domain-analysis/0.1.0
X_COLLECTION_MODE=nitter_rss
X_NITTER_BASE_URL=https://nitter.net
X_BEARER_TOKEN=
