# 两台开发机共享本地连接配置，但 PostgreSQL 数据分别保留在各自电脑，不通过 Git 同步。
# DBOS 要求连接串显式包含用户名；本地开发账号直接保存在这里，外部环境变量仍可覆盖。
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_PORT=6173
POSTGRES_DATABASE_URL=postgresql://guojunxi@127.0.0.1:5432/domain_analysis
INTERVIEW_MODEL_ID=gpt-5.6-terra
INTERVIEW_REASONING_EFFORT=medium
